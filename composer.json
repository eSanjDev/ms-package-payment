{
    "name": "esanj/payment-client",
    "description": "Laravel client package for the Esanj Payment Microservice",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Esanj",
            "email": "esanjdev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "ext-json": "*",
        "esanj/auth-bridge": ">=1.0.0 <2.0.0",
        "firebase/php-jwt": "^7.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0",
        "psr/log": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Esanj\\PaymentClient\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Esanj\\PaymentClient\\PaymentClientServiceProvider"
            ],
            "aliases": {
                "Payment": "Esanj\\PaymentClient\\Facades\\Payment"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
